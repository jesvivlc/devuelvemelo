NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NUNCA exponer — solo servidor
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic — obtener en console.anthropic.com
# NUNCA exponer — solo servidor
ANTHROPIC_API_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend — obtener en resend.com/api-keys
# NUNCA exponer — solo servidor
RESEND_API_KEY=
# Email remitente verificado en Resend
RESEND_FROM_EMAIL=Devuélvemelo <avisos@tudominio.com>

# Vercel Cron — string aleatorio seguro (ej: openssl rand -hex 32)
CRON_SECRET=
